    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <ProjectReference Include="../Xcaciv.Echos.Core/Xcaciv.Echos.Core.csproj" />
    <ProjectReference Include="../Xcaciv.Echos.Context/Xcaciv.Echos.Context.csproj" />
    <ProjectReference Include="../Xcaciv.Echos.Capture/Xcaciv.Echos.Capture.csproj" />
    <ProjectReference Include="../Xcaciv.Echos.Llm/Xcaciv.Echos.Llm.csproj" />
