<Window
    x:Class="Xcaciv.Echos.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Echos">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid x:Name="DragRegion">
            <TextBlock Text="Echos · drag to move" VerticalAlignment="Center" FontWeight="SemiBold" />
        </Grid>
        <StackPanel Grid.Row="1" Spacing="8">
            <TextBlock Text="Your floating assistant" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="Off by default. Observation reads the foreground app's accessible UI. Enable screen or system audio separately. Hiding does not pause observation."
                       TextWrapping="Wrap" />
            <TextBlock x:Name="DisclosureText" TextWrapping="Wrap" FontSize="12" />
        </StackPanel>
        <StackPanel Grid.Row="2" Spacing="6">
            <ToggleSwitch x:Name="ObservationToggle" Header="Observation + send context" OffContent="Off — no collection or network" OnContent="On — every 10 seconds" Toggled="OnConsentChanged" />
            <ToggleSwitch x:Name="ScreenToggle" Header="Include screen capture + local OCR" OffContent="Off" OnContent="On" Toggled="OnConsentChanged" />
            <ToggleSwitch x:Name="AudioToggle" Header="Include system audio + remote transcription" OffContent="Off" OnContent="On" Toggled="OnConsentChanged" />
        </StackPanel>
        <TextBlock Grid.Row="3" x:Name="StatusText" Text="Observation is off." TextWrapping="Wrap" />
        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="SuggestionText" Text="Suggestions appear here after you opt in." TextWrapping="Wrap" IsTextSelectionEnabled="True" />
        </ScrollViewer>
        <StackPanel Grid.Row="5" Spacing="6">
            <TextBlock x:Name="ShortcutText" TextWrapping="Wrap" FontSize="12" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="HideButton" Content="Hide" Click="OnHide" />
                <Button Content="Exit" Click="OnExit" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
